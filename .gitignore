# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/
# esbuild output for the Lambda bundles
/dist-lambda/

# production
/build

# local audit artifacts
/.data/
/public/audit-artifacts/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Committed on purpose: points the dev client at the local API host, no secrets.
!.env.development
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers visual brainstorm
/.superpowers/

# terraform — working directories, state and any variable file that could hold a
# real value. `.terraform.lock.hcl` is committed on purpose so CI resolves the
# same provider versions a human did.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
